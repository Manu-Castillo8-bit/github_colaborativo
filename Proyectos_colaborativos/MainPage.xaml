<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyectos_colaborativos.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="20">

            <Label
                Text="Conversor MXN a USD"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="¿Cuántos dólares puedes adquirir con tu dinero mexicano?"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="16" />

            <Label
                Text="Cantidad en pesos mexicanos (MXN)"
                SemanticProperties.HeadingLevel="Level4" />

            <Entry
                x:Name="PesosEntry"
                Placeholder="Ej. 1500.50"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing"
                Completed="OnConvertClicked" />

            <Label
                Text="Tipo de cambio (1 USD = ? MXN)"
                SemanticProperties.HeadingLevel="Level4" />

            <Entry
                x:Name="RateEntry"
                Placeholder="Ej. 18.50"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing"
                Completed="OnConvertClicked" />

            <Button
                x:Name="ConvertBtn"
                Text="Convertir a dólares"
                Clicked="OnConvertClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="ClearBtn"
                Text="Limpiar"
                Clicked="OnClearClicked"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource Gray300}"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource Black}}" />

            <Border
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource PrimaryDark}}"
                StrokeShape="RoundRectangle 12"
                Padding="20"
                Margin="0,10,0,0">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                    <Label
                        Text="Resultado"
                        FontSize="16"
                        HorizontalOptions="Center" />
                    <Label
                        x:Name="ResultLabel"
                        Text="—"
                        FontSize="34"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center"
                        SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>